# ─── Nebius Token Factory (NVIDIA Nemotron) ─────────────────
NEBIUS_API_KEY=your_nebius_api_key_here
# Get a key at: https://tokenfactory.nebius.com → API keys
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Nano is cheap and fast. Switch to nvidia/nemotron-3-super-120b-a12b if tool use is unreliable.
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
AGENT_MAX_STEPS=5
NEBIUS_TIMEOUT_MS=60000
# Output budget per model call, including Nemotron's reasoning
NEMOTRON_MAX_TOKENS=4096

# ─── Database (SQLite, no account needed) ────────────────────
DB_PATH=./data/bumiwatch.db

# ─── WAQI (air quality) ──────────────────────────────────────
WAQI_API_KEY=your_waqi_token_here
# Get free token at: https://aqicn.org/data-platform/token/

# ─── NASA FIRMS ──────────────────────────────────────────────
NASA_FIRMS_API_KEY=your_nasa_firms_key_here
# Get free key at: https://firms.modaps.eosdis.nasa.gov/api/area/

# ─── BMKG and Open-Meteo (no key needed) ─────────────────────

# ─── Global Forest Watch (optional) ──────────────────────────
GFW_API_KEY=your_gfw_key_here

# ─── Pipeline / agent settings ───────────────────────────────
# The pipeline runs inside the agent server. Set to false to run it separately.
RUN_PIPELINE=true
PIPELINE_INTERVAL_MINUTES=30
AGENT_PORT=3001
# Questions per minute per IP on POST /api/agent
AGENT_RATE_LIMIT=10
# Comma-separated sites allowed to call the API. Leave empty for local dev;
# set it to the frontend's URL when deploying.
CORS_ORIGINS=
# Set to 1 when running behind a proxy/load balancer (Render, Fly, Railway, nginx)
TRUST_PROXY=
LOG_LEVEL=info
