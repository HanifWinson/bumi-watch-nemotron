{
  "name": "bumiwatch",
  "version": "2.0.0",
  "description": "Indonesia Environmental Intelligence Platform: NVIDIA Nemotron agent on Nebius Token Factory",
  "type": "module",
  "scripts": {
    "start": "node agent/index.js",
    "dev": "node --watch agent/index.js",
    "agent": "node agent/index.js",
    "pipeline": "node pipeline/index.js",
    "pipeline:once": "node pipeline/index.js --once",
    "setup": "node -e \"import('./config/db.js').then(m => { m.setupDatabase(); console.log('Database ready:', process.env.DB_PATH || './data/bumiwatch.db') })\"",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
